//| mill-version: 1.1.5
//| mill-jvm-version: temurin:25
//| mill-jvm-opts: ["-Xss16m", "-XX:NonProfiledCodeHeapSize=250m", "-XX:ReservedCodeCacheSize=500m"]
//| mvnDeps: ["dev.propensive:crux-mill:0.1.1"]

// `-Xss16m`: the Scala 3.10 compiler recurses deeply in `SmapRegistry.include` (the inline
// source maps) and overflows a 2 MB thread stack on this build's model module, as it does on
// Soundness's own; the extra reservation is virtual and costs nothing until used.
package build

import mill.*
import scalalib.*
import publish.*
// crux (propensive/crux): the pinned releases on GitHub, read directly as Coursier repositories.
import crux.*

object settings:
  // The compiler is the propensive Scala fork, Proscala, at this version: pinned in `deps` below
  // like the libraries and resolved from its GitHub release by crux, which also forces every
  // `org.scala-lang` artifact to it, since the pinned libraries name the release each was built
  // with. The fork stays TASTy-compatible across its patch releases, which is what every such
  // pin assumes.
  val scalaVersion = "3.10.0-pro-1.0.2"

  // This build's version. A release's version is declared once, by its tag: the release
  // (release.sh in propensive/.github) and a snapshot (snapshot.sh) both name it in
  // `PYROCOSM_RELEASE_VERSION`. Any other build is the version after the latest release reachable
  // from HEAD — its patch version plus one, which sorts after that release and before whichever
  // follows it — or `0.0.1` where no release tag is reachable, as in CI's shallow checkout.
  // Called from `Task.Input`s, so the environment and the tags are read on every invocation.
  def version(env: Map[String, String]): String =
    env.get("PYROCOSM_RELEASE_VERSION").filter(_.nonEmpty).getOrElse(nextVersion)

  def nextVersion: String =
    val root = mill.api.BuildCtx.workspaceRoot

    val latest: Option[String] =
      scala.util.Try:
        os.proc("git", "describe", "--tags", "--abbrev=0", "--match", "[0-9]*.[0-9]*.[0-9]*")
        . call(cwd = root, stderr = os.Pipe).out.text().trim
      . toOption

    def numeric(part: String): Boolean = part.nonEmpty && part.forall(_.isDigit)

    latest.collect:
      case s"$major.$minor.$patch" if Seq(major, minor, patch).forall(numeric) =>
        s"$major.$minor.${patch.toInt + 1}"
    . getOrElse("0.0.1")

  val scalaOptions = Seq(
    "-Zalias-captures",
    "-Zdiagnostic-givens",
    "-Zgiven-prefixes",
    "-Zinline-source-maps",
    "-Zopaque-mutability",
    "-Zpure-iarrays",
    "-Zfrozen-pure",
    "-Zretains-bounds",
    "-Zretains-skolems",
    "-Zspreadable-varargs",
    "-Zunboxed-pure-types",
    "-Zunion-captures",
    "-experimental",
    "-new-syntax",
    "-feature",
    "-preview",
    "-deprecation",
    "-Wunused:imports",
    "-Wimplausible-patterns",
    "-Xmax-inlines", "32",
    "-Yno-flexible-types",
    "-Yexplicit-nulls",
    "-Ycheck-all-patmat",
    "-language:experimental.modularity",
    "-language:experimental.dependent",
    "-language:experimental.relaxedLambdaSyntax",
    "-language:experimental.genericNumberLiterals",
    "-language:experimental.into",
    "-language:experimental.erasedDefinitions",
    "-language:implicitConversions",
    "-language:experimental.saferExceptions",
    "-language:experimental.strictEqualityPatternMatching",
    "-language:experimental.subCases",
    "-language:experimental.multiSpreads",
    // Capture checking as throughout Soundness. Separation checking is left off for now, as in
    // flame: the web module threads WebSocket handlers the separation checker rejects.
    "-Ycc-new",
    "-language:experimental.captureChecking"
  )

  // The proscenium predef, as fume and flame: `scala` is deliberately not imported.
  val predef = Seq("-Yno-predef", "-Yimports:java.lang,proscenium")

  def component(soundness: String)(name: String): Dep = mvn"dev.propensive:$name:$soundness"

  // The model is pure data and typeclasses; every dependency here is Scala.js-capable, so the
  // module can later cross-compile for a browser-side renderer.
  def modelDeps(soundness: String) = Seq(
    "gossamer-core", "rudiments-core", "vacuous-core", "prepositional-core", "contingency-core",
    "spectacular-core", "wisteria-core", "fulminate-core", "denominative-core", "aviation-core",
    "clavichord-core",     // Keypress
    "quantitative-core",   // Quantity, for measures
    "acyclicity-core",     // Dag, for graphs
    "archimedes-core",     // MathML
    "punctuation-core",    // Markdown -> Block
    "digression-core",     // StackTrace
    "dissonance-core",     // Diff
    "jacinta-core",        // JSON, at the browser edge only, and exhibited as a tree
    "stratiform-core",     // TEL codecs, the canonical wire form, and TEL exhibited as a tree
    "xylophone-core",      // XML -> Block.Tree
    "breviloquence-core",  // CBOR -> Block.Tree
    "ypsiloid-core")       // YAML -> Block.Tree
  . map(component(soundness))

  // The image codecs (hallucination) are here so that a `Block.Image` carrying a data: URI can
  // be decoded and drawn in colour (escapade's half-block rendering of a `Graphical`).
  def terminalDeps(soundness: String) = Seq(
    "ultimatum-core", "ultimatum-gauges", "ultimatum-tables", "escapade-core", "escapade-io",
    "escritoire-core", "dendrology-dag", "dendrology-tree", "tessellate-core", "harlequin-ansi",
    "profanity-core", "turbulence-stdio", "hieroglyph-core", "iridescence-core", "parasite-jvm",
    "escapade-graphics", "anticipation-gfx", "hallucination-core", "hallucination-formats",
    "monotonous-core")
  . map(component(soundness))

  def webDeps(soundness: String) = Seq(
    "honeycomb-core", "cataclysm-core", "graffiti-core", "perihelion-core", "scintillate-server",
    "jacinta-core", "iridescence-core", "eucalyptus-core")
  . map(component(soundness))

  // The instances that need the compiler: harlequin highlighting, delicious diagnostic markup,
  // and the compiler's notices (anthology) as diagnostics; kaleidoscope reads the lines of a
  // missing-given search.
  def compilerDeps(soundness: String) =
    Seq("harlequin-core", "delicious-core", "anthology-core", "kaleidoscope-core").map(component(soundness))

  // The instances for rich media: raster images (hallucination, every format it implements) and
  // SVG drawings (savagery), carried as data: URIs and markup; monotonous encodes the Base64.
  def mediaDeps(soundness: String) = Seq(
    "hallucination-core", "hallucination-formats", "savagery-core", "monotonous-core",
    "gesticulate-core")
  . map(component(soundness))

  // Git notes as metadata storage: guillotine drives `git`; stratiform is the note body codec.
  def notesDeps(soundness: String) = Seq(
    "guillotine-core", "stratiform-core", "ambience-core", "eucalyptus-core", "hieroglyph-core")
  . map(component(soundness))

  // The standard command line of every tool: the daemon (ethereal), subcommands, completions
  // and the manpage (exoskeleton), the configuration files (galilei, stratiform) and their XDG
  // locations (ambience), and the version a manpage carries (revolution).
  // What a script's `Runtime` is made of: Stdio, Environment and WorkingDirectory, and Text.
  def scriptDeps(soundness: String) = Seq(
    "anticipation-text", "ambience-core", "turbulence-stdio", "vacuous-core")
  . map(component(soundness))

  def cliDeps(soundness: String) = Seq(
    "exoskeleton-completions", "exoskeleton-manpage", "ethereal-core", "ambience-core",
    "galilei-jvm", "serpentine-core", "stratiform-core", "revolution-core", "parasite-core",
    "eucalyptus-core", "guillotine-core",
    "telekinesis-core", "telekinesis-jvm", "urticose-core", "gastronomy-core", "aviation-core",  // the upgrade check
    "escapade-core", "iridescence-core", "escritoire-core")  // `about`'s banner and tables
  . map(component(soundness))

  // Connections between tools on different machines: TLS sockets (coaxial), content digests
  // (gastronomy), the blob cache and identity files (galilei, ambience), bundling directories
  // (zeppelin), and the BinTEL wire form (stratiform).
  def remoteDeps(soundness: String) = Seq(
    "coaxial-jvm", "gastronomy-core", "galilei-jvm", "ambience-core", "zeppelin-core",
    "stratiform-core", "urticose-core", "parasite-core", "eucalyptus-core", "serpentine-core",
    "monotonous-core", "gossamer-core", "contingency-core", "vacuous-core", "hieroglyph-core",
    "aviation-core",      // invitations' expiry
    "stratiform-base256") // an invitation as one word
  . map(component(soundness))

  // The bus the swarm carries: the wire types and their derived BinTEL codecs and acceptance.
  // Nothing beyond the remote module's surface, from which it takes stratiform and aviation.
  def busDeps(soundness: String) = remoteDeps(soundness) ++ Seq("inimitable-core").map(component(soundness))

  // The swarm: the links between nodes (coaxial, through the remote module), their tasks
  // (parasite), the daemon's journal (eucalyptus), the local registry (galilei, ambience), the
  // mDNS advertisement of an inviting machine (syndesis) and the versions nodes declare
  // (revolution).
  def swarmDeps(soundness: String) = busDeps(soundness) ++ Seq(
    "syndesis-core", "revolution-semver", "parasite-jvm")
  . map(component(soundness))

  def demoDeps(soundness: String) = Seq("exoskeleton-completions", "ethereal-core").map(component(soundness))
  def testDeps(soundness: String) = Seq("probably-cli", "probably-events", "yossarian-core").map(component(soundness))

  // What a build of a tool identifies itself as, written into its jar as
  // `META-INF/pyrocosm/<name>/version` for `pyrocosm-cli` to read (`<name> about`,
  // `<name> --version`): the version a release or snapshot is published as, when
  // `PYROCOSM_RELEASE_VERSION` names it (`make snapshot` and the release both set it);
  // otherwise the next version (`nextVersion`) with the filtered tree hash of HEAD — the
  // identity `make snapshot` would give this commit — and `-dirty` if the working tree has
  // changes that no commit records. Called from a `Task.Input`, so that HEAD is consulted on
  // every invocation.
  def buildVersion(env: Map[String, String]): String =
    env.get("PYROCOSM_RELEASE_VERSION").filter(_.nonEmpty).getOrElse:
      val root = mill.api.BuildCtx.workspaceRoot

      val tree: String =
        scala.util.Try(os.proc("./etc/shared", "filtered_tree.py", "HEAD").call(cwd = root).out.text().trim)
          .getOrElse(os.proc("git", "rev-parse", "HEAD^{tree}").call(cwd = root).out.text().trim)

      val dirty: Boolean = os.proc("git", "status", "--porcelain").call(cwd = root).out.text().trim.nonEmpty
      s"$nextVersion-${tree.take(12)}${if dirty then "-dirty" else ""}"

  // The date a build of a tool was released, written beside its version as
  // `META-INF/pyrocosm/<name>/date` (`<name> about`): `PYROCOSM_RELEASE_DATE` when it is set,
  // and otherwise the date of HEAD's commit, as `YYYY-MM-DD`, so that the same commit always
  // builds the same jar.
  def buildDate(env: Map[String, String]): String =
    env.get("PYROCOSM_RELEASE_DATE").filter(_.nonEmpty).getOrElse:
      val root = mill.api.BuildCtx.workspaceRoot
      os.proc("git", "log", "-1", "--format=%cs").call(cwd = root).out.text().trim

// The propensive libraries this build depends on, pinned in etc/refs (the format, the snapshot flow
// and the shared scripts are documented in propensive/.github): each is a release `X.Y.Z`, or a
// snapshot `X.Y.Z-<12 hex>` of an unreleased upstream build, published there by `make snapshot`.
// crux resolves each — and, transitively, what each was built against — from its GitHub release;
// nothing is installed locally. The Proscala pin is declared here rather than in etc/refs, which
// deps.py (propensive/.github) also reads and which does not yet know the form of a Proscala
// version. The file is read as a source, so editing it invalidates every resolution.
object deps extends CruxModule:
  def refsFiles = Task.Sources(mill.api.BuildCtx.workspaceRoot / "etc" / "refs")
  def declared = Seq(Pin("propensive/proscala", settings.scalaVersion))

  def soundness: T[String] = Task(version("soundness")())

// A module compiled with the pinned fork, against the pinned libraries.
trait Fork extends CruxScalaModule:
  def crux = deps

trait Project extends Module:
  def moduleDir = super.moduleDir / os.up / "src"

trait Component(dependencies: PublishModule*) extends Fork:
  override def scalacOptions = settings.scalaOptions ++ settings.predef

  // Concatenate the beneficence index fragments rather than letting last-one-wins truncate
  // them, exactly as the flame, fume and Soundness builds do.
  override def assemblyRules = super.assemblyRules ++ Seq(
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/givens/.*"),
    mill.javalib.Assembly.Rule.AppendPattern("META-INF/services/.*"))
  def moduleId: String = moduleDir.last
  def moduleDeps: Seq[PublishModule] = dependencies
  def sources = Task.Sources(moduleDir)

  // The beneficence plugin indexes givens and test suites into `META-INF`; fume discovers the
  // suites through that index and nothing else.
  override def scalacPluginMvnDeps = Task(Seq(settings.component(deps.soundness())("beneficence-plugin")))

trait Publishing extends Fork, SonatypeCentralPublishModule:
  // A `Task.Input` reading `Task.env`, not a plain value: `PYROCOSM_RELEASE_VERSION` is how a
  // release and `make snapshot` (release.sh and snapshot.sh in propensive/.github) drive the
  // version through a Mill daemon that is already running — the daemon freezes `sys.env` at its
  // own start, while `Task.env` is the environment of each `./mill` invocation. Without it, the
  // version is `settings.nextVersion`.
  def publishVersion = Task.Input:
    settings.version(Task.env)
  def artifactSuffix = Task("")

  def pomSettings = Task(PomSettings(
    description = "pyrocosm",
    organization = "dev.propensive",
    url = "https://propensive.dev/pyrocosm/",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("propensive", "pyrocosm"),
    developers = Seq(Developer("propensive", "Jon Pretty", "https://github.com/propensive"))))

  override def docJar = Task:
    val jar = Task.dest / "empty.jar"
    val zos = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(jar.toIO))
    zos.close()
    PathRef(jar)

object pyrocosm extends Project:
  // The semantic model: Inline, Block, Interface, Live, Event, Presentable. Pure data and
  // typeclasses, with no renderer. Published as `dev.propensive:pyrocosm-model`.
  object model extends Component(), Publishing:
    def mvnDeps = Task(settings.modelDeps(deps.soundness()))

  // Exhibitions of compiler-facing types (highlighted source, semantic diagnostics), JVM-only
  // because harlequin drives the compiler. `dev.propensive:pyrocosm-compiler`.
  object compiler extends Component(model), Publishing:
    def mvnDeps = Task(settings.compilerDeps(deps.soundness()))

  // Exhibitions of rich media — a raster image as a `Block.Image` holding a data: URI, an SVG
  // drawing as a `Block.Figure` — JVM-only because hallucination's codecs are. Named givens, for
  // import by name, like the compiler module's. `dev.propensive:pyrocosm-media`.
  object media extends Component(model), Publishing:
    def mvnDeps = Task(settings.mediaDeps(deps.soundness()))

  // The terminal renderer and frontend, on Ultimatum. `dev.propensive:pyrocosm-terminal`.
  object terminal extends Component(model), Publishing:
    def mvnDeps = Task(settings.terminalDeps(deps.soundness()))

  // The web renderer and frontend, on Honeycomb, Graffiti and Perihelion.
  // `dev.propensive:pyrocosm-web`.
  object web extends Component(model), Publishing:
    def mvnDeps = Task(settings.webDeps(deps.soundness()))
    def resources = Task.Sources(mill.api.BuildCtx.workspaceRoot / "res" / "web")

  // Metadata in git notes, keyed by filtered tree hashes (Pyrocosm hashes), for every tool.
  // JVM-only, because it runs `git`. `dev.propensive:pyrocosm-notes`.
  object notes extends Component(model), Publishing:
    def mvnDeps = Task(settings.notesDeps(deps.soundness()))

  // The standard command line of a Pyrocosm tool — `about`, `install`, `quit`, `swarm`,
  // `--version`, the configuration files and the daemon-side web front-end — for every tool's
  // client. Depends on the swarm, which every tool's daemon joins, and on no renderer, so that
  // a tool without a web front-end depends on no web server. `dev.propensive:pyrocosm-cli`.
  object cli extends Component(swarm), Publishing:
    def mvnDeps = Task(settings.cliDeps(deps.soundness()))

  // The contract a single-file script is compiled against: the `Runtime` a tool constructs for
  // it (Fever for Scala; lira's fever.md §6a). Its own module, with no dependency on the rest of
  // Pyrocosm, so a script compiles against this small, slowly-changing surface rather than a
  // tool's release. `dev.propensive:pyrocosm-script`.
  object script extends Component(), Publishing:
    def mvnDeps = Task(settings.scriptDeps(deps.soundness()))

  // Reaching another machine's tool: `Machine` declarations, the TLS `Peer` identity and
  // handshake, the framed BinTEL `Channel`, and the content-addressed `Blobs` store, shared by
  // fume (remote test runs) and Fury. Depends on no other module here. `dev.propensive:pyrocosm-remote`.
  object remote extends Component(), Publishing:
    def mvnDeps = Task(settings.remoteDeps(deps.soundness()))

    // Compiled WITHOUT capture checking, as Probably's `events` module is: stratiform's derived
    // TEL codecs — the handshake's, and every tool's message codec made through `Channel` —
    // expand to instances the capture checker sees as fresh capabilities where a pure instance
    // is required. Their derivation sites must therefore sit in an unchecked module; tools
    // keep their own message enums in one too (fume's `relay`).
    override def scalacOptions =
      (settings.scalaOptions ++ settings.predef).filterNot: option =>
        option == "-Ycc-new" || option == "-language:experimental.captureChecking"

  // What the swarm carries between nodes: `Node`, `Advert`, the bus `Event`s and the `Wire`
  // messages, with their derived BinTEL codecs and the acceptance by which two builds agree
  // what to say. Unchecked for the same reason as `remote`: every derivation site is here, so
  // that `swarm` is checked. `dev.propensive:pyrocosm-bus`.
  object bus extends Component(model, remote), Publishing:
    def mvnDeps = Task(settings.busDeps(deps.soundness()))

    override def scalacOptions =
      (settings.scalaOptions ++ settings.predef).filterNot: option =>
        option == "-Ycc-new" || option == "-language:experimental.captureChecking"

  // The swarm every tool's daemon is a node of: the registry by which nodes on one machine find
  // each other, the links between them and to other machines, the gateway which relays between
  // the two, and the bus of events they carry. `dev.propensive:pyrocosm-swarm`.
  object swarm extends Component(bus), Publishing:
    def mvnDeps = Task(settings.swarmDeps(deps.soundness()))

  // The gallery: every node in both frontends, the fixture for judging appearance.
  object demo extends Component(terminal, web, cli):
    def mvnDeps = Task(settings.demoDeps(deps.soundness()))
    def finalMainClass = "pyrocosm.gallery"

    // The gallery's own version, as `gallery about` reports it: see `settings.buildVersion`.
    def buildVersion = Task.Input(settings.buildVersion(Task.env))
    def buildDate = Task.Input(settings.buildDate(Task.env))

    override def resources = Task:
      val directory = Task.dest / "META-INF" / "pyrocosm" / "gallery"
      os.write.over(directory / "version", buildVersion() + "\n", createFolders = true)
      os.write.over(directory / "date", buildDate() + "\n", createFolders = true)
      super.resources() ++ Seq(PathRef(Task.dest))

  object test extends Component(model, compiler, media, terminal, web, notes, cli, remote, bus, swarm):
    def mvnDeps = Task(settings.testDeps(deps.soundness()))
    def finalMainClass = "pyrocosm.Tests"

    // Unchecked like `remote`, whose codec derivations the tests exercise at their own types.
    override def scalacOptions =
      (settings.scalaOptions ++ settings.predef).filterNot: option =>
        option == "-Ycc-new" || option == "-language:experimental.captureChecking"

// The release: the ten library modules' jars, each with its POM and ivy.xml embedded under
// `META-INF/maven/<group>/<artifactId>/`, named `<artifactId>-<version>.jar`, exactly as the
// Soundness build stages its jars. A jar so staged is all a consumer needs: Soundness's
// `sync_releases.py` (pointed at this repository with `SOUNDNESS_RELEASE_REPO`) reconstructs
// the ivy2 layout coursier resolves from, and Burdock, given `--github propensive/pyrocosm`,
// matches the jar on a launcher's classpath to the released asset by digest and externalizes
// it. The release (release.sh in propensive/.github) uploads what `stage` produces.
object release extends Module:
  def modules: Seq[PublishModule] =
    Seq(pyrocosm.model, pyrocosm.compiler, pyrocosm.media, pyrocosm.terminal, pyrocosm.web,
        pyrocosm.notes, pyrocosm.cli, pyrocosm.remote, pyrocosm.script, pyrocosm.bus, pyrocosm.swarm)

  private def withDescriptors(source: os.Path, target: os.Path, entries: Seq[(String, os.Path)])
  :   Unit =
    val input = new java.util.zip.ZipFile(source.toIO)
    val output = new java.util.zip.ZipOutputStream(new java.io.FileOutputStream(target.toIO))
    try
      val existing = input.entries()
      while existing.hasMoreElements do
        val entry = existing.nextElement()
        output.putNextEntry(new java.util.zip.ZipEntry(entry.getName))
        if !entry.isDirectory then input.getInputStream(entry).transferTo(output)
        output.closeEntry()

      for (name, file) <- entries do
        output.putNextEntry(new java.util.zip.ZipEntry(name))
        output.write(os.read.bytes(file))
        output.closeEntry()
    finally
      output.close()
      input.close()

  // The ivy.xml published beside each jar as `<artifactId>-<version>.ivy.xml`: the metadata
  // Coursier reads when crux (propensive/crux) uses the release as an Ivy-pattern repository,
  // without the sources and javadoc publications. Mill declares those in the `compile`
  // configuration too, and the crux artifact pattern names the main jar for any publication
  // without a classifier, so left in place they would resolve to the jar itself.
  private def stripDescriptor(ivy: String): String =
    val artifact = """<artifact\b[^>]*?(?:/>|>\s*</artifact>)""".r
    val filtered = artifact.replaceAllIn(ivy, found =>
      if found.matched.contains("classifier=") || found.matched.matches("""(?s).*\btype="(src|doc)".*""")
      then "" else java.util.regex.Matcher.quoteReplacement(found.matched))
    filtered.linesIterator.filter(_.trim.nonEmpty).mkString("", "\n", "\n")

  def stage: T[Seq[PathRef]] = Task:
    val jars: Seq[(PathRef, String, String, String, PathRef, PathRef)] =
      Task.traverse(modules)(module =>
        Task.Anon((module.jar(), module.pomSettings().organization, module.artifactId(),
                   module.publishVersion(), module.pom(), module.ivy())))()

    jars.flatMap: (jar, group, artifactId, version, pom, ivy) =>
      val target = Task.dest / s"$artifactId-$version.jar"
      val prefix = s"META-INF/maven/$group/$artifactId"
      val descriptors = Seq(s"$prefix/pom.xml" -> pom.path, s"$prefix/ivy.xml" -> ivy.path)
      withDescriptors(jar.path, target, descriptors)
      val metadata = Task.dest / s"$artifactId-$version.ivy.xml"
      os.write.over(metadata, stripDescriptor(os.read(ivy.path)))
      Seq(PathRef(target), PathRef(metadata))
