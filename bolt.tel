tel 1.0 propensive.dev/bolt

# Bolt codes of Pyrocosm and its tools, which share the letter `f`: `subdivision 8` / `error 1` /
# `variant 3` is ↯/f.8.1.3. Each module of Pyrocosm is a subdivision, numbered so that each comes
# after those it depends on (`harness` 1 to `cli` 14); then the modules of each tool, in the order
# of their dependencies, each named for its tool: fever 15–16, flame 17–20, flare 21–24, fuel
# 25–28, fume 29–32 and fury 33–35. A subdivision added later takes the next number. Errors and
# the diagnostics a tool reports alike have codes. A code which carries another, as
# ↯/f.10.1/f.8.1.3 or ↯/f.21.1/c.2.2.1, reports its error on account of that one.
#
# This is the record of the letter `f` which the index of bolt codes, `projects.tel` in
# propensive/bolt, names; its schema is `bolt.tel` there. A tool's codes are recorded here, not in
# the tool's own repository. A code, once assigned, is permanent: a number is never reused, and
# one which is withdrawn stays, marked `retired`.

project f pyrocosm
  summary  Pyrocosm, the framework of Propensive's tools, and the tools built on it

  subdivision 1 harness
  subdivision 2 model
  subdivision 3 compiler
  subdivision 4 media
  subdivision 5 script
  subdivision 6 system
  subdivision 7 notes
    error 1 notes
      symbol Notes.Error
      summary  An operation on the git notes in which Pyrocosm's tools record what they know fails
      source src/notes/pyrocosm.Notes.scala
      variant 1 bad-ref
        summary  a refspec does not name a commit
      variant 2 git-failed
        summary  git exits with a failing status
      variant 3 undecodable
        summary  a note cannot be decoded
      variant 4 diverged
        summary  the notes on a remote have diverged from the local notes
  subdivision 8 remote
    error 1 peer
      symbol Peer.Error
      summary  A connection to another machine cannot be made
      source src/remote/pyrocosm.Peer.scala
      variant 1 no-identity
        summary  the machine declares no identity fingerprint to pin
      variant 2 no-token
        summary  the machine declares no token
      variant 3 unreachable
        summary  the machine cannot be connected to
      variant 4 refused
        summary  the peer refuses the connection
      variant 5 protocol
        summary  the peer speaks another protocol
      variant 6 disconnected
        summary  the peer closes the connection during the handshake
      variant 7 identity
        summary  this machine's identity cannot be created or read
    error 2 invitation
      symbol Invitation.Error
      summary  An invitation to connect to a machine is not accepted
      source src/remote/pyrocosm.Invitation.scala
      variant 1 malformed
        summary  it is not an invitation
      variant 2 expired
        summary  it has expired
      variant 3 used
        summary  it has been used already
      variant 4 tool
        summary  it is an invitation to another tool
      variant 5 unwritable
        summary  the machine it invites to cannot be recorded
  subdivision 9 bus
  subdivision 10 swarm
    error 1 swarm
      symbol Swarm.Error
      summary  A ping to another machine fails; a failed connection carries its own code, ↯/f.10.1/f.8.1.3, in place of a variant
      source src/swarm/pyrocosm.Swarm.scala
      variant 2 unanswered
        summary  the connection closes before a pong arrives
      variant 3 silent
        summary  no pong arrives in time
      variant 4 mismatched
        summary  the two nodes cannot agree a protocol
  subdivision 11 terminal
  subdivision 12 web
  subdivision 13 hub
  subdivision 14 cli

  # fever
  subdivision 15 fever-core
    error 1 launch
      symbol Launch.Error
      summary  A compiled script has no entry point which Fever can run
      source src/core/fever.Launch.scala
      variant 1 no-main
        summary  the script defines no top-level `def main(using Runtime): Unit`
      variant 2 wrong-signature
        summary  the script's `main` has a signature other than `def main(using Runtime): Unit`
      variant 3 uninspectable
        summary  the compiled script's TASTy cannot be inspected, or its class cannot be loaded
    error 2 script
      symbol Script.Error
      summary  A script's header is invalid; a header which is not TEL carries TEL's own code, ↯/f.15.2/s.118.1/t.1.7, in place of a variant
      source src/core/fever.Script.scala
      variant 2 no-separator
        summary  the file has no `##` line separating the header from the source
      variant 3 invalid
        summary  the header breaks the script schema; each rejection is a diagnostic carrying the code of the TEL error which found it
    error 3 not-resident
      summary  A script named by `fever stop` is not resident in the daemon
      source src/core/fever.Scripts.scala
    error 4 compiler-crash
      summary  The compiler crashes rather than finishing a script's compilation
      source src/core/fever.Scripts.scala
    error 5 unanticipated
      summary  Running a script throws what no exit status anticipates, a bug in Fever; it carries the throwable's own code, if it has one
      source src/core/fever_cli.scala
    error 6 unimplemented
      summary  A subcommand is not yet implemented
      source src/core/fever_cli.scala
    error 7 usage
      summary  The command line is not understood
      source src/core/fever_cli.scala
  subdivision 16 fever-launcher

  # flame
  subdivision 17 flame-core
    error 1 submission-failed
      summary  A submission could not be evaluated, and is answered with a failure; a failure on account of a coded error carries that error's code
      source src/core/flame.Repl.scala
      variant 1 unprocessed
        summary  the input could not be compiled or run, because something escaped the engine's guards
      variant 2 unrendered
        summary  the result could not be rendered as a reply
      variant 3 unanswered
        summary  an asynchronous submission could not be processed
      variant 4 thrown
        summary  an asynchronous submission raised an error which no guard caught
    error 2 session-refused
      summary  The session named at startup could not be opened as asked
      source src/core/flame.ReplInterface.scala
      variant 1 missing
        summary  no session of that name exists to join
      variant 2 exists
        summary  a session of that name already exists, so it cannot be created
    error 3 no-active-session
      summary  A submission arrived on a connection which has no active session
      source src/core/flame.Sessions.scala
    error 4 request-failed
      summary  A request to the REPL server could not be answered; a failure on account of a coded error carries that error's code
      source src/core/flame.Sessions.scala
      variant 1 unparsed
        summary  the request could not be parsed
      variant 2 thrown
        summary  answering the request raised an error
  subdivision 18 flame-web
    error 1 request-failed
      summary  A web page's request to the in-process sessions raised an error; it carries the error's own code, if it has one
      source src/web/flame_web.scala
    error 2 no-such-session
      summary  A REST API request names a session which does not exist
      source src/web/flame_web.scala
    error 3 malformed-body
      summary  A REST API request's body is not the JSON the endpoint expects
      source src/web/flame_web.scala
      variant 1 eval
        summary  the body of an `eval` request is not `{"code": "…"}`
      variant 2 complete
        summary  the body of a `complete` request is not `{"code": "…", "offset": N}`
  subdivision 19 flame-client
    error 1 session-arguments
      summary  The arguments choosing a session contradict each other, or are incomplete
      source src/client/flame_client.scala
      variant 1 join-and-create
        summary  both `--join` and `--create` are given
      variant 2 join-unnamed
